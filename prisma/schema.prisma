generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ProviderType {
  openai
  gemini
  anthropic
  groq
  openrouter
  alibaba
  local
}

enum AuthType {
  bearer
  none
}

enum RoutingStrategy {
  fixed
  random
  roundRobin
  weighted
  priorityFailover
}

enum UsageStatus {
  success
  error
  rateLimited
  authError
  notFound
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id        String           @id @default(cuid())
  name      String           @unique
  type      ProviderType
  baseUrl   String
  authType  AuthType         @default(bearer)
  enabled   Boolean          @default(true)
  models    ProviderModel[]
  apiKeys   ProviderAPIKey[]
  usageLogs UsageLog[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ProviderAPIKey {
  id           String       @id @default(cuid())
  providerId   String
  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name         String
  apiKey       String
  organization String?
  priority     Int          @default(0)
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ProviderModel {
  id                String                  @id @default(cuid())
  providerId        String
  provider          Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId           String
  displayName       String?
  enabled           Boolean                 @default(true)
  maxContext        Int?
  supportsVision    Boolean                 @default(false)
  supportsImage     Boolean                 @default(false)
  supportsReasoning Boolean                 @default(false)
  supportsVietnamese Boolean                @default(false)
  bestTaskTags      String                  @default("[]")
  metadata          String?
  permissions       InboundModelPermission[]
  usageLogs         UsageLog[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([providerId, modelId])
}

model InboundAPIKey {
  id              String                    @id @default(cuid())
  name            String                    @unique
  key             String                    @unique
  keyEncrypted    String
  enabled         Boolean                   @default(true)
  description     String?
  routingStrategy RoutingStrategy           @default(fixed)
  rateLimitRPM    Int?
  rateLimitTPM    Int?
  dailyLimit      Int?
  monthlyLimit    Int?
  permissions     InboundModelPermission[]
  usageLogs       UsageLog[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model InboundModelPermission {
  id              String          @id @default(cuid())
  apiKeyId        String
  apiKey          InboundAPIKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  providerModelId String
  providerModel   ProviderModel   @relation(fields: [providerModelId], references: [id], onDelete: Cascade)
  enabled         Boolean         @default(true)
  priority        Int             @default(0)
  weight          Int             @default(1)
  rateLimitRPM    Int?
  rateLimitTPM    Int?
  dailyLimit      Int?
  monthlyLimit    Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([apiKeyId, providerModelId])
}

model UsageLog {
  id              String          @id @default(cuid())
  apiKeyId        String?
  apiKey          InboundAPIKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  providerId      String?
  provider        Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerModelId String?
  providerModel   ProviderModel?  @relation(fields: [providerModelId], references: [id], onDelete: SetNull)
  endpoint        String?
  model           String?
  requestTokens   Int             @default(0)
  responseTokens  Int             @default(0)
  cost            Float           @default(0)
  latency         Int             @default(0)
  stream          Boolean         @default(false)
  status          UsageStatus
  error           String?
  createdAt       DateTime        @default(now())

  @@index([apiKeyId])
  @@index([providerId])
  @@index([providerModelId])
  @@index([createdAt])
}
